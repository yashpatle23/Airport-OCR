# Local FastAPI resource limits. Copy to .env before docker compose if changing
# defaults. Invalid or out-of-range values fail application startup.
# The fixed 5 MiB upload policy is intentionally not configurable.

# Concurrent native extraction tasks per Uvicorn process (1..8).
AIRPORT_OCR_MAX_CONCURRENCY=2
# Maximum PDF pages accepted after opening the document (1..500).
AIRPORT_OCR_MAX_PDF_PAGES=100
# Maximum positioned native-text words across the PDF (1..1,000,000).
AIRPORT_OCR_MAX_NATIVE_WORDS=250000
# Maximum vector drawing objects read from any single page (1..100,000).
AIRPORT_OCR_MAX_DRAWINGS_PER_PAGE=20000
# Maximum retained black vector segments across all pages (1..1,000,000).
AIRPORT_OCR_MAX_VECTOR_SEGMENTS=100000
